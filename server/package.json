{
  "name": "pixelpact",
  "version": "1.0.0",
  "description": "Pixelpact gets you started quickly with visual testing for the web.",
  "type": "module",
  "author": "Ergon Informatik AG",
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "start": "LOG_LEVEL=debug node --watch src/index.js | pino-pretty",
