    "mhtml-to-html": "2.2.0",
    "pino": "10.4.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.0",
    "vitest": "5.1.0"
  }
}
